<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Outer border: 2dp bright white for pressed feedback -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
            <!-- Body: pressed darker amber gradient -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#CC5200"
                        android:endColor="#FF8F00" />
                </shape>
            </item>
            <!-- Subtle specular top gloss -->
            <item android:top="2dp" android:bottom="26dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="5dp"
                        android:topRightRadius="5dp"
                        android:bottomLeftRadius="1dp"
                        android:bottomRightRadius="1dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFE600"
                        android:centerColor="#FF9900"
                        android:endColor="#E65100" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="26dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="5dp"
                        android:topRightRadius="5dp"
                        android:bottomLeftRadius="1dp"
                        android:bottomRightRadius="1dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#99FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <stroke android:width="1dp" android:color="#FFF59D" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State -->
    <item>
        <layer-list>
            <!-- Outer shadow/border: 8dp radius, #8C3B00 2dp stroke -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#8C3B00" />
                </shape>
            </item>
            <!-- Main body gradient: vertical gradient from #FFE600 -> #FF9900 -> #E65100 -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFE600"
                        android:centerColor="#FF9900"
                        android:endColor="#E65100" />
                </shape>
            </item>
            <!-- Top Specular Glass Highlight: top half overlay fading #99FFFFFF to #00FFFFFF -->
            <item android:top="2dp" android:bottom="26dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="5dp"
                        android:topRightRadius="5dp"
                        android:bottomLeftRadius="1dp"
                        android:bottomRightRadius="1dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#99FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <!-- Inner bevel stroke: 1dp #FFF59D (light gold) -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <stroke android:width="1dp" android:color="#FFF59D" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
