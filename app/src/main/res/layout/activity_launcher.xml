<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0: Fullscreen Background Wallpaper -->
    <ImageView
        android:id="@+id/launcher_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_bg" />

    <!-- Layer 1: 35% Black Scrim Overlay for High Foreground Contrast -->
    <View
        android:id="@+id/launcher_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <!-- Layer 2: Main Foreground Layout -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:paddingLeft="40dp"
        android:paddingTop="20dp"
        android:paddingRight="40dp"
        android:paddingBottom="16dp">

        <!-- Brand / Logo Section (Left Side) -->
        <LinearLayout
            android:id="@+id/brand_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/menu_layout"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="450dp"
                android:maxHeight="300dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/r_logo" />

            <!-- Asset Status Indicator (Visible only if assets missing/installing) -->
            <TextView
                android:id="@+id/asset_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:text="@string/asset_status_ready"
                android:textColor="#4ADE80"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Menu Buttons Section (Right Side) -->
        <LinearLayout
            android:id="@+id/menu_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_play"
                android:layout_width="280dp"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/btn_retro_play"
                android:elevation="4dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:stateListAnimator="@null"
                android:text="@string/btn_play"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_retro_sega"
                android:elevation="2dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:stateListAnimator="@null"
                android:text="@string/btn_settings"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_multiplayer"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_retro_sega"
                android:elevation="2dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:stateListAnimator="@null"
                android:text="@string/btn_multiplayer"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_mods"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_retro_sega"
                android:elevation="2dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:stateListAnimator="@null"
                android:text="@string/btn_mods"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_reinstall"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="160dp"
                android:background="@drawable/btn_retro_silver"
                android:elevation="2dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_reinstall_assets"
                android:textAllCaps="true"
                android:textColor="#263238"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Installation Progress Overlay (Replaces menu during copy) -->
        <LinearLayout
            android:id="@+id/progress_card"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="24dp"
            android:background="@drawable/card_retro_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/progress_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:text="@string/status_copying"
                android:textColor="#FFE600"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_bar_custom" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/progress_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:text="Scanning..."
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="sans-serif-bold"
                    android:text="0%"
                    android:textColor="#FFE600"
                    android:textSize="13sp" />

            </RelativeLayout>

        </LinearLayout>

        <!-- Version & Build Info Footer -->
        <TextView
            android:id="@+id/footer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/version_info"
            android:textColor="#ECEFF1"
            android:textSize="12sp" />

    </RelativeLayout>

</FrameLayout>
