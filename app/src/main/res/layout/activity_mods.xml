<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0: Fullscreen Background Wallpaper -->
    <ImageView
        android:id="@+id/mods_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_bg" />

    <!-- Layer 1: 35% Black Scrim Overlay -->
    <View
        android:id="@+id/mods_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <!-- Layer 2: Main Foreground Content -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/card_container"
            android:layout_width="660dp"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:background="@drawable/card_retro_panel"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <!-- Title Header -->
            <TextView
                android:id="@+id/mods_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:text="@string/title_mods"
                android:textAllCaps="true"
                android:textColor="#FFE600"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mods_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:text="MODS &amp; DISPLAY SETTINGS"
                android:textAllCaps="true"
                android:textColor="#82B1FF"
                android:textSize="11sp" />

            <!-- Navigation Tabs: Mods vs Display Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tab_mods"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_retro_play"
                    android:elevation="3dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    android:stateListAnimator="@null"
                    android:text="MODS (VFS)"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tab_display"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_retro_sega"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    android:stateListAnimator="@null"
                    android:text="DISPLAY SETTINGS"
                    android:textAllCaps="true"
                    android:textColor="#E0F2FE"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============================================================= -->
            <!-- TAB 1: MODS CONTAINER                                        -->
            <!-- ============================================================= -->
            <LinearLayout
                android:id="@+id/view_mods_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Storage Directory Indicator -->
                <TextView
                    android:id="@+id/tv_mods_path"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="Mods folder: files/mods/"
                    android:textColor="#90CAF9"
                    android:textSize="10sp" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:background="#64B5F6" />

                <!-- Controls Toolbar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <!-- Master Toggle -->
                    <CheckBox
                        android:id="@+id/cb_master_enable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFE600"
                        android:checked="true"
                        android:fontFamily="sans-serif-bold"
                        android:text="Enable Mods"
                        android:textColor="#E0F2FE"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Import Mod Button -->
                    <Button
                        android:id="@+id/btn_import_mod"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_retro_play"
                        android:elevation="2dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="1"
                        android:shadowDy="2"
                        android:shadowRadius="2"
                        android:stateListAnimator="@null"
                        android:text="+ IMPORT MOD"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Refresh Button -->
                    <Button
                        android:id="@+id/btn_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_retro_silver"
                        android:elevation="2dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:stateListAnimator="@null"
                        android:text="REFRESH"
                        android:textAllCaps="true"
                        android:textColor="#263238"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Mod List / Empty View Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="6dp">

                    <ScrollView
                        android:id="@+id/scroll_mods"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <LinearLayout
                            android:id="@+id/mods_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <TextView
                        android:id="@+id/tv_empty_mods"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:padding="20dp"
                        android:text="No mods installed.\n\nTap '+ IMPORT MOD' to select a mod folder or zip archive,\nor copy mods into your files/mods/ directory."
                        android:textColor="#90CAF9"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- ============================================================= -->
            <!-- TAB 2: DISPLAY SETTINGS CONTAINER                             -->
            <!-- ============================================================= -->
            <ScrollView
                android:id="@+id/view_display_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:layout_marginBottom="6dp"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp">

                    <!-- 1. Aspect Ratio Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_input_field"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aspect Ratio"
                            android:fontFamily="sans-serif-bold"
                            android:shadowColor="#CC000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="1"
                            android:textColor="#FFE600"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto adapts to modern widescreen phones (Hor+). 16:9 standardizes wide display. 4:3 restores original retro pillarbox."
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinner_aspect_ratio"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/btn_retro_sega" />
                    </LinearLayout>

                    <!-- 2. Internal Render Scale Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_input_field"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Internal Render Scale"
                            android:fontFamily="sans-serif-bold"
                            android:shadowColor="#CC000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="1"
                            android:textColor="#FFE600"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Native draws at crisp full display resolution. 720p balances battery &amp; speed. 480p gives authentic retro Saturn pixelation."
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinner_render_scale"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/btn_retro_sega" />
                    </LinearLayout>

                    <!-- 3. HUD Safe Zone Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_input_field"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <CheckBox
                            android:id="@+id/cb_hud_safe_zone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FFE600"
                            android:checked="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="Center HUD in 4:3 Safe Zone"
                            android:textColor="#FFE600"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="When checked, gauges (speedometer, minimap, lap counter) stay centered inside traditional 4:3 sightlines. When unchecked, gauges push out to screen edges."
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"
                            android:layout_marginStart="28dp"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <!-- 4. FOV Multiplier Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_input_field"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Field of View (FOV) Multiplier"
                            android:fontFamily="sans-serif-bold"
                            android:shadowColor="#CC000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="1"
                            android:textColor="#FFE600"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.0x is default 3D camera view. Higher values expand the camera view frustum further."
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinner_fov"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/btn_retro_sega" />
                    </LinearLayout>

                    <!-- Reset Display Defaults Button -->
                    <Button
                        android:id="@+id/btn_reset_display"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/btn_retro_silver"
                        android:elevation="2dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05"
                        android:stateListAnimator="@null"
                        android:text="RESET DISPLAY TO DEFAULTS"
                        android:textAllCaps="true"
                        android:textColor="#263238"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>

            <!-- Back Button -->
            <Button
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/btn_retro_sega"
                android:elevation="2dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:stateListAnimator="@null"
                android:text="@string/btn_back"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
