<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0: Fullscreen Background Wallpaper -->
    <ImageView
        android:id="@+id/settings_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_bg" />

    <!-- Layer 1: 35% Black Scrim Overlay for High Foreground Contrast -->
    <View
        android:id="@+id/settings_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <!-- Layer 2: Main Foreground Content -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/card_container"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/card_retro_panel"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="16dp"
            android:paddingEnd="36dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:text="@string/title_settings"
                android:textAllCaps="true"
                android:textColor="#FFE600"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:text="@string/settings_audio_subtitle"
                android:textAllCaps="true"
                android:textColor="#82B1FF"
                android:textSize="11sp" />

            <View
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="#64B5F6" />

            <!-- Music Volume Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="6dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/settings_music_volume"
                        android:textColor="#E0F2FE"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/music_volume_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="sans-serif-black"
                        android:shadowColor="#CC000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:text="80%"
                        android:textColor="#FFE600"
                        android:textSize="13sp" />
                </RelativeLayout>

                <SeekBar
                    android:id="@+id/seek_music_volume"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="#FFE600"
                    android:thumbTint="#FFE600" />
            </LinearLayout>

            <!-- Sound Effects Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/settings_sfx_volume"
                        android:textColor="#E0F2FE"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/sfx_volume_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="sans-serif-black"
                        android:shadowColor="#CC000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:text="100%"
                        android:textColor="#4ADE80"
                        android:textSize="13sp" />
                </RelativeLayout>

                <SeekBar
                    android:id="@+id/seek_sfx_volume"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#4ADE80"
                    android:thumbTint="#4ADE80" />
            </LinearLayout>

            <!-- Touch Controls Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:background="#3382B1FF" />

            <TextView
                android:id="@+id/controls_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:text="@string/settings_controls_subtitle"
                android:textAllCaps="true"
                android:textColor="#82B1FF"
                android:textSize="11sp" />

            <!-- Control Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btn_customize_controls"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_retro_sega"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_customize_controls"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_reset_controls"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_retro_silver"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_reset_controls"
                    android:textAllCaps="true"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Display & Widescreen Settings Button -->
            <Button
                android:id="@+id/btn_display_settings"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_retro_play"
                android:elevation="3dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:stateListAnimator="@null"
                android:text="DISPLAY &amp; RESOLUTION SETTINGS"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Bottom Action Row: About & Back -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <Button
                    android:id="@+id/btn_about"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_retro_silver"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_about"
                    android:textAllCaps="true"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_retro_sega"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_back"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
