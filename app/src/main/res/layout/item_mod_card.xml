<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_room_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Enabled Toggle Checkbox -->
    <CheckBox
        android:id="@+id/cb_mod_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#FFCC00"
        android:layout_marginEnd="8dp" />

    <!-- Mod Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_mod_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Test Soap Sonic"
            android:textColor="#FFEB3B"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_mod_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="v1.0 • by Community"
            android:textColor="#80D8FF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_mod_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:text="Custom character asset replacement"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <!-- Badges Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_badge_noblink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_lobby"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="NO-BLINK"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tv_badge_dir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_race"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="DIR: files/"
                android:textColor="#60A5FA"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
